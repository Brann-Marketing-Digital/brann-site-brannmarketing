---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import IconCards from '../components/IconCards.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import TeamSection from '../components/TeamSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site } from '../config/site';
import fotoRedes from '../assets/servicos/gestao-redes-sociais.jpg';
import fotoSite from '../assets/servicos/criacao-site.jpg';
import fotoIdentidade from '../assets/servicos/identidade-visual.jpg';
import fotoVideos from '../assets/servicos/producao-videos.jpg';
import fotoSeo from '../assets/servicos/seo-estrutural.jpg';
import fotoTrafego from '../assets/servicos/trafego-pago.jpg';
import fotoLeads from '../assets/servicos/captacao-leads.jpg';
import fotoFerramentas from '../assets/servicos/ferramentas-sob-medida.jpg';
import guilherme from '../assets/equipe/guilherme-viana.png';
import joao from '../assets/equipe/joao-duarte.png';
import gustavo from '../assets/equipe/gustavo-sorato.png';

const servicos = [
  { icon: 'ph:heart-duotone', title: 'Gestão de redes sociais' },
  { icon: 'ph:browser-duotone', title: 'Criação de site' },
  { icon: 'ph:palette-duotone', title: 'Criação de identidade visual' },
  { icon: 'ph:video-camera-duotone', title: 'Produção de vídeos' },
  { icon: 'ph:magnifying-glass-duotone', title: 'SEO estrutural' },
  { icon: 'ph:cursor-click-duotone', title: 'Tráfego pago' },
  { icon: 'ph:funnel-duotone', title: 'Captação de leads' },
  { icon: 'ph:puzzle-piece-duotone', title: 'Ferramentas digitais sob medida' },
];

const motivos = [
  {
    icon: 'ph:seal-check-duotone',
    title: 'Resultados comprovados',
    text: 'Nossa abordagem estratégica e criativa já ajudou diversas empresas a alcançarem sucesso em seus esforços de marketing.',
  },
  {
    icon: 'ph:sparkle-duotone',
    title: 'Inovação constante',
    text: 'Estamos sempre buscando novas tendências e tecnologias para garantir que sua marca se destaque em um mercado em constante evolução.',
  },
  {
    icon: 'ph:wallet-duotone',
    title: 'Custo-benefício',
    text: 'Nossos planos e pacotes são feitos para atender exatamente a necessidade do cliente: não é uma despesa, é um investimento.',
  },
];

const equipe = [
  {
    name: 'Guilherme Viana',
    role: 'Head Comercial e Vendas',
    photo: guilherme,
  },
  { name: 'João Duarte', role: 'Head de Estratégia e Criação', photo: joao },
  {
    name: 'Gustavo Sorato',
    role: 'Head de Operações e Processos',
    photo: gustavo,
  },
];
---

<BaseLayout title={site.name} description={site.description}>
  <Hero
    title={site.tagline}
    highlight="posicionamento e resultado"
    text="Estratégia de verdade, desenhada para o momento, os objetivos e o mercado do seu negócio. Mais do que entregar serviços, entregamos direção, organização e resultado."
  />
  <AboutSection
    id="sobre"
    title="Uma agência que faz diferente"
    items={[
      {
        icon: 'ph:rocket-launch-duotone',
        title: 'Onde tudo começou',
        text: 'A Brann nasceu em 2021 com o propósito de oferecer ao mercado uma abordagem mais estratégica e personalizada em marketing.',
      },
      {
        icon: 'ph:lightbulb-duotone',
        title: 'Decidimos fazer diferente',
        text: 'Nossos fundadores buscavam agências que realmente entendessem as necessidades de cada empresa, mas encontravam serviços padronizados. Daí veio a decisão de fazer diferente.',
      },
      {
        icon: 'ph:chart-line-up-duotone',
        title: 'Presença digital com resultado',
        text: 'Desde então, atendemos empresas de diferentes segmentos e portes, sempre com foco em fortalecer a presença digital, ampliar a visibilidade e construir posicionamento.',
      },
    ]}
  />
  <IconCards
    id="servicos"
    tone="alt"
    columns={4}
    title="Nossos serviços"
    intro="Tudo o que a sua marca precisa para aparecer, ser lembrada e vender."
    items={servicos}
  />
  <FeatureBlock
    title="Gestão de redes sociais"
    text="Planejamos, criamos e publicamos o conteúdo da sua marca para você ser visto, lembrado e manter uma presença digital consistente."
    points={[
      'Planejamento de conteúdo alinhado ao seu posicionamento',
      'Criação de posts, artes e vídeos',
      'Acompanhamento dos resultados',
    ]}
    image={fotoRedes}
    imageAlt="Ilustração 3D de um celular com curtidas, comentários e notificações"
  />
  <FeatureBlock
    title="Criação de site"
    text="Sites rápidos e bonitos, pensados para transformar visitantes em contatos e prontos para serem encontrados no Google."
    points={[
      'Layout que funciona bem no celular',
      'Estrutura pensada para conversão',
      'Botão direto para o seu WhatsApp',
    ]}
    tone="alt"
    reverse
    image={fotoSite}
    imageAlt="Ilustração 3D de uma página de site com imagem, textos e botões"
  />
  <FeatureBlock
    title="Criação de identidade visual"
    text="Branding é gerir a estratégia da marca com planejamento de longo prazo, para que sua empresa seja percebida do jeito que deseja e cresça de forma inteligente e duradoura."
    points={[
      'Posicionamento claro no mercado',
      'Identidade visual consistente',
      'Reputação sólida com o seu público',
    ]}
    image={fotoIdentidade}
    imageAlt="Ilustração 3D de uma paleta de tintas, amostras de cores e um lápis"
  />
  <FeatureBlock
    title="Produção de vídeos"
    text="Vídeos pensados, gravados e editados para fazer sua marca aparecer ainda mais nas redes sociais."
    tone="alt"
    reverse
    image={fotoVideos}
    imageAlt="Ilustração 3D de uma câmera de vídeo, uma claquete e um botão de play"
  />
  <FeatureBlock
    title="SEO estrutural"
    text="Seu site organizado para ser encontrado no Google: estrutura, velocidade e páginas bem montadas."
    points={[
      'Auditoria técnica do site',
      'Arquitetura de páginas, títulos e descrições',
      'Velocidade e experiência no celular',
    ]}
    image={fotoSeo}
    imageAlt="Ilustração 3D de uma barra de busca com uma lupa sobre o primeiro resultado"
  />
  <FeatureBlock
    title="Tráfego pago"
    text="Anúncios no Google e no Meta que levam pessoas interessadas até o seu WhatsApp."
    points={[
      'Campanhas no Google Ads e no Meta Ads',
      'Públicos e remarketing',
      'Medição de conversões e relatórios simples',
    ]}
    tone="alt"
    reverse
    image={fotoTrafego}
    imageAlt="Ilustração 3D de uma janela de site com um cursor clicando em um anúncio e um alvo"
  />
  <FeatureBlock
    title="Captação de leads"
    text="Atrair visitantes é só o primeiro passo. O resultado acontece quando eles entram em um funil de vendas estruturado e se transformam em leads qualificados."
    points={[
      'Captura e qualificação de leads',
      'Formulários inteligentes e estratégias de conversão',
      'Automação de marketing para nutrir cada contato',
    ]}
    image={fotoLeads}
    imageAlt="Ilustração 3D de um funil que transforma contatos em um cartão de lead"
  />
  <FeatureBlock
    title="Ferramentas digitais sob medida"
    text="Precisa de algo que não existe pronto? A gente desenha e constrói para o seu negócio."
    points={[
      'Plataforma de vídeos e treinamentos para equipes',
      'Área de membros ou área do cliente',
      'Painéis e sistemas internos',
    ]}
    tone="alt"
    reverse
    image={fotoFerramentas}
    imageAlt="Ilustração 3D de peças de quebra-cabeça, uma engrenagem e um painel de gráficos"
  />
  <IconCards
    tone="default"
    title="Por que escolher a Brann Marketing?"
    items={motivos}
  />
  <TeamSection
    id="equipe"
    title="Quem está à frente da Brann"
    intro="Três fundadores, unidos pelo mesmo objetivo e apoiados por uma rede de especialistas, para fazer acontecer."
    members={equipe}
  />
  <CtaBanner
    title="Fale conosco!"
    text="Conte para a gente o momento da sua marca e vamos desenhar o próximo passo juntos."
    label={site.cta.label}
    href={site.cta.href}
  />
</BaseLayout>
