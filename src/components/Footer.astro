---
import { Icon } from 'astro-icon/components';
import Container from './Container.astro';
import Logo from './Logo.astro';
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <Container class="grid gap-10 py-12 lg:grid-cols-[1.5fr_3fr]">
    <div class="space-y-4">
      <a
        href="/"
        aria-label={`${site.name} - página inicial`}
        class="inline-block"
      >
        <Logo variant="branco" class="w-40" />
      </a>
      <p class="max-w-xs text-sm text-white/70">{site.tagline}</p>
      <ul class="flex gap-3">
        {site.social.map((item) => (
          <li>
            <a
              href={item.href}
              aria-label={item.label}
              class="grid size-9 place-items-center rounded-full border border-white/25 text-white/70 transition-colors hover:border-brand-400 hover:text-brand-400"
            >
              <Icon name={item.icon} class="size-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-8">
      {site.footerColumns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="mb-3 text-sm font-semibold">{column.title}</h2>
          <ul class="space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/70 transition-colors hover:text-brand-400"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </Container>

  <div class="border-t border-white/15">
    <Container class="flex flex-col gap-3 py-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}. Todos os direitos reservados.
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {site.legalLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-brand-400">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </div>
</footer>
