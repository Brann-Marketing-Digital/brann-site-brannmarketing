---
import { Icon } from 'astro-icon/components';
import Container from './Container.astro';
import Button from './Button.astro';
import Logo from './Logo.astro';
import { site } from '../config/site';

const instagram = site.social.find((item) => item.label === 'Instagram');
---

<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur">
  <Container class="flex h-16 items-center justify-between gap-6 md:h-20">
    <a href="/" aria-label={`${site.name} - página inicial`}>
      <Logo class="w-32 sm:w-36 md:w-54" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-muted transition-colors hover:text-brand-700"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {instagram && (
        <a
          href={instagram.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram da Brann (abre em nova aba)"
          class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-brand-50 hover:text-brand-700"
        >
          <Icon name={instagram.icon} class="size-5" />
        </a>
      )}
      <Button href={site.cta.href} class="max-sm:hidden">
        {site.cta.label}
      </Button>
      <button
        type="button"
        id="menu-toggle"
        class="rounded-md p-2 text-ink md:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
      >
        <Icon name="lucide:menu" class="size-6" data-icon="open" />
        <Icon name="lucide:x" class="hidden size-6" data-icon="close" />
      </button>
    </div>
  </Container>

  <nav
    id="menu-mobile"
    aria-label="Menu mobile"
    class="hidden border-t border-line bg-white md:hidden"
  >
    <Container class="flex flex-col gap-1 py-4">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-2 py-3 text-base font-medium hover:bg-brand-50"
        >
          {item.label}
        </a>
      ))}
      <Button href={site.cta.href} class="mt-2">
        {site.cta.label}
      </Button>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    toggle
      .querySelector('[data-icon="open"]')
      ?.classList.toggle('hidden', open);
    toggle
      .querySelector('[data-icon="close"]')
      ?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
