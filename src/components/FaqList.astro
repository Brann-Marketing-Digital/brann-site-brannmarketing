---
/** Perguntas frequentes abertas e fechadas com o elemento nativo do navegador. */
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import type { Faq } from '../data/servicos';

interface Props {
  id?: string;
  title?: string;
  items: Faq[];
  tone?: 'default' | 'alt';
}

const { id, title = 'Perguntas frequentes', items, tone = 'default' } = Astro.props;
---

<Section id={id} {tone}>
  <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
    <div class="divide-y divide-line border-y border-line">
      {items.map((item) => (
        <details class="group py-1">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-display text-lg font-semibold transition-colors hover:text-brand-700 [&::-webkit-details-marker]:hidden">
            {item.q}
            <Icon
              name="lucide:plus"
              class="size-5 shrink-0 text-brand-600 transition-transform duration-200 ease-out group-open:rotate-45 motion-reduce:transition-none"
            />
          </summary>
          <p class="max-w-prose pb-5 text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
