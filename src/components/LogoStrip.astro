---
import Section from './Section.astro';
import type { ClientLogo } from '../config/site';

interface Props {
  id?: string;
  title: string;
  logos: readonly ClientLogo[];
}

const { id, title, logos } = Astro.props;
---

<Section id={id} class="!py-10 lg:!py-12">
  <p class="mb-6 text-center text-sm font-semibold text-muted">{title}</p>
  <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
    {logos.map((logo) => (
      <li class="grid h-12 place-items-center">
        {logo.src ? (
          <img
            src={logo.src}
            alt={logo.name}
            loading="lazy"
            class="max-h-10 w-auto opacity-70 grayscale transition-[opacity,filter] duration-200 ease-out hover:opacity-100 hover:grayscale-0"
          />
        ) : (
          <span class="font-display text-lg font-bold text-muted">
            {logo.name}
          </span>
        )}
      </li>
    ))}
  </ul>
</Section>
