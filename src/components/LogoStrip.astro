---
import Section from './Section.astro';

interface Props {
  id?: string;
  title: string;
  logos: string[];
}

const { id, title, logos } = Astro.props;
---

<Section id={id} class="!py-12 lg:!py-14">
  <p class="mb-8 text-center text-lg font-semibold">{title}</p>
  <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
    {logos.map((logo) => (
      <li class="grid h-16 place-items-center rounded-lg border border-dashed border-line text-sm text-muted">
        {logo}
      </li>
    ))}
  </ul>
</Section>
