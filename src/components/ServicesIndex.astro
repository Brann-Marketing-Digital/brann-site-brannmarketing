---
/**
 * Índice dos serviços em três grupos. Cada serviço leva ao seu bloco de
 * detalhe mais abaixo na página.
 */
import Section from './Section.astro';

interface Group {
  id: string;
  title: string;
  services: { id: string; title: string }[];
}

interface Props {
  id?: string;
  title: string;
  intro?: string;
  groups: Group[];
}

const { id, title, intro, groups } = Astro.props;
---

<Section id={id} tone="alt" class="!py-14 lg:!py-20">
  <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <div class="space-y-3">
      <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
      {intro && <p class="max-w-md text-lg text-muted">{intro}</p>}
    </div>
    <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
      {groups.map((group) => (
        <nav aria-labelledby={`${group.id}-indice`}>
          <a
            href={`#${group.id}`}
            id={`${group.id}-indice`}
            class="font-display text-lg font-bold text-ink transition-colors hover:text-brand-700"
          >
            {group.title}
          </a>
          <ul class="mt-3 space-y-1 border-t-2 border-brand-600 pt-3">
            {group.services.map((service) => (
              <li>
                <a
                  href={`#${service.id}`}
                  class="block py-1 text-muted underline-offset-4 transition-colors hover:text-brand-700 hover:underline"
                >
                  {service.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
</Section>
