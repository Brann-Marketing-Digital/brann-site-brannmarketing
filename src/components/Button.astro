---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'light' | 'outline-light';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60';
const variants = {
  primary: 'bg-brand-600 text-white hover:bg-brand-700',
  outline: 'border border-brand-600 text-brand-700 hover:bg-brand-50',
  light: 'bg-white text-brand-700 hover:bg-brand-50',
  'outline-light': 'border border-white/40 text-white hover:bg-white/10',
};
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};
const external = href?.startsWith('http');
const classes = [base, variants[variant], sizes[size], className];
---

{href ? (
  <a
    href={href}
    class:list={classes}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <slot />
  </a>
) : (
  <button type={type} class:list={classes}>
    <slot />
  </button>
)}
