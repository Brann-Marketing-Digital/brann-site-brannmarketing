---
/**
 * Detalhe de um serviço: texto, tópicos e imagem. Fica dentro de um
 * ServiceGroup, que dá o fundo e o botão de contato.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  title: string;
  text: string;
  points?: string[];
  image: ImageMetadata;
  imageAlt: string;
  /** Inverte a ordem texto/imagem no desktop. */
  reverse?: boolean;
  /** Página completa do serviço. */
  href?: string;
}

const { id, title, text, points = [], image, imageAlt, reverse = false, href } =
  Astro.props;
---

<article
  id={id}
  class="grid scroll-mt-24 items-center gap-8 md:scroll-mt-28 lg:grid-cols-2 lg:gap-16"
>
  <div class:list={['space-y-4', reverse && 'lg:order-2']}>
    <h3 class="text-2xl font-bold sm:text-3xl">{title}</h3>
    <p class="text-lg text-muted">{text}</p>
    {points.length > 0 && (
      <ul class="space-y-2 pt-2">
        {points.map((point) => (
          <li class="flex items-start gap-2">
            <Icon
              name="lucide:check"
              class="mt-0.5 size-5 shrink-0 text-brand-600"
            />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )}
    {href && (
      <a
        href={href}
        class="inline-flex items-center gap-1.5 pt-2 font-semibold text-brand-700 underline-offset-4 hover:underline"
      >
        Saiba mais sobre {title.toLowerCase()}
        <Icon name="lucide:arrow-right" class="size-4" />
      </a>
    )}
  </div>
  <div class="group aspect-[16/10] overflow-hidden rounded-card border-4 border-brand-600 lg:aspect-[4/3]">
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 560px, 100vw"
      class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
</article>
