---
/**
 * Um grupo de serviços: título do grupo, os blocos de detalhe (slot) e um
 * botão de WhatsApp com mensagem própria do grupo.
 */
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import Button from './Button.astro';
import { whatsappLink } from '../config/site';

interface Props {
  id: string;
  title: string;
  intro: string;
  /** Mensagem já escrita no WhatsApp. */
  message: string;
  ctaLabel: string;
  tone?: 'default' | 'alt';
}

const { id, title, intro, message, ctaLabel, tone = 'default' } = Astro.props;
---

<Section id={id} {tone} class="scroll-mt-16 md:scroll-mt-20">
  <div class="mb-10 max-w-2xl space-y-3 lg:mb-16">
    <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
    <p class="text-lg text-muted">{intro}</p>
  </div>
  <div class="space-y-14 lg:space-y-24">
    <slot />
  </div>
  <div class="mt-14 flex flex-col items-start gap-3 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between lg:mt-20">
    <p class="font-display text-lg font-semibold">{ctaLabel}</p>
    <Button href={whatsappLink(message)}>
      <Icon name="simple-icons:whatsapp" class="size-4" />
      Conversar sobre isso
    </Button>
  </div>
</Section>
